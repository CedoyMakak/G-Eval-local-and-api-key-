# openai | openrouter | ollama
JUDGE_PROVIDER=openrouter

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# OpenRouter — любая модель из каталога, не только Gemma
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embeddings (multilingual, подходит для русского)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Агрегация: overall = w_sem * cosine + w_lex * lexical + w_judge * judge
# Подобранные grid search по Spearman на HITL (n=59, живая Gemma): судья лучше смеси
WEIGHT_SEMANTIC=0.00
WEIGHT_LEXICAL=0.00
WEIGHT_JUDGE=1.00
DISAGREEMENT_THRESHOLD=0.25
JUDGE_TEMPERATURE=0.0

# Ensemble: off | mean | min
JUDGE_ENSEMBLE=off
JUDGE_ENSEMBLE_PROVIDERS=openrouter,ollama
JUDGE_SWAP_CHECK=false
POSITION_BIAS_PENALTY=0.08
POSITION_BIAS_THRESHOLD=0.15
